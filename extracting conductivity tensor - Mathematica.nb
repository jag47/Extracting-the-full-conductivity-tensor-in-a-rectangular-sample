Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"side", " ", "lengths", " ", "of", " ", "the", " ", 
     RowBox[{"sample", ".", "d1"}], " ", "is", " ", "along", " ", "the", " ", 
     "horizontal"}], ",", 
    RowBox[{"d2", " ", "along", " ", "the", " ", "vertical"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"d1", "=", "2.7"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"d2", "=", "1.2"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "current", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"j", "=", "1.3"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Resistance", " ", "from", " ", "vertex", " ", "configurations"}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"R1", " ", "=", " ", 
     RowBox[{"0.2127", "/", "j"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"R2", " ", "=", " ", 
     RowBox[{"0.0218", "/", "j"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"R3", " ", "=", " ", 
     RowBox[{
      RowBox[{"-", "0.0727"}], "/", "j"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Resistance", " ", "from", " ", "midpoint", " ", "configuration"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"R5", " ", "=", " ", 
     RowBox[{"0.0626", "/", "j"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"find", " ", "r"}], ",", " ", 
     RowBox[{"a", " ", "hypergeometric", " ", "parameter"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"r", " ", "=", " ", 
    RowBox[{"sol", "/.", 
     RowBox[{"FindRoot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"1", "-", 
         SuperscriptBox["sol", "2"]}], "==", 
        SuperscriptBox["sol", 
         RowBox[{"2", 
          RowBox[{"R1", "/", "R2"}]}]]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"sol", ",", 
         RowBox[{"1", "/", "2"}], ",", "0", ",", "1"}], "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "calculate", " ", "the", " ", "geometric", " ", "mean", " ", "of", " ", 
     "the", " ", "anisotropic", " ", "conductivities"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"geomean", " ", "=", 
    RowBox[{"-", " ", 
     FractionBox[
      RowBox[{"R1", "*", "\[Pi]", "*", 
       RowBox[{"Log", "[", 
        RowBox[{"1", "-", 
         SuperscriptBox["r", "2"]}], "]"}]}], 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"R1", "*", "\[Pi]"}], ")"}], "2"], "+", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{"R1", "*", 
           RowBox[{"Log", "[", 
            RowBox[{
             FractionBox["1", 
              SuperscriptBox["r", "2"]], "-", "1"}], "]"}]}], "+", 
          RowBox[{"R3", "*", 
           RowBox[{"Log", "[", 
            RowBox[{"1", "-", 
             SuperscriptBox["r", "2"]}], "]"}]}]}], ")"}], "2"]}]]}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Hall", " ", "conductivity"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"\[Sigma]H", " ", "=", " ", 
    FractionBox[
     RowBox[{
      RowBox[{"Log", "[", 
       RowBox[{"1", "-", 
        SuperscriptBox["r", "2"]}], "]"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"R3", "*", 
         RowBox[{"Log", "[", 
          RowBox[{"1", "-", 
           SuperscriptBox["r", "2"]}], "]"}]}], "+", 
        RowBox[{"R1", "*", 
         RowBox[{"Log", "[", 
          RowBox[{
           FractionBox["1", 
            SuperscriptBox["r", "2"]], "-", "1"}], "]"}]}]}], ")"}]}], 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"R1", "*", "\[Pi]"}], ")"}], "2"], "+", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"R1", "*", 
          RowBox[{"Log", "[", 
           RowBox[{
            FractionBox["1", 
             SuperscriptBox["r", "2"]], "-", "1"}], "]"}]}], "+", 
         RowBox[{"R3", "*", 
          RowBox[{"Log", "[", 
           RowBox[{"1", "-", 
            SuperscriptBox["r", "2"]}], "]"}]}]}], ")"}], "2"]}]]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "location", " ", "of", " ", "the", " ", "midpoint", " ", "in", " ", "the",
      " ", "complex", " ", "plane"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"z5", " ", "=", " ", 
    FractionBox[
     RowBox[{
      FractionBox["1", 
       SuperscriptBox["r", "2"]], "-", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "-", 
         SuperscriptBox["r", "2"]}], ")"}], 
       RowBox[{
        RowBox[{"-", "R5"}], "/", "R1"}]]}], 
     RowBox[{"1", "-", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "-", 
         SuperscriptBox["r", "2"]}], ")"}], 
       RowBox[{
        RowBox[{"-", "R5"}], "/", "R1"}]]}]]}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"find", " ", "a"}], ",", " ", 
     RowBox[{"hypergeometric", " ", "parameter"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"a", "=", " ", 
    RowBox[{"sol", "/.", 
     RowBox[{"FindRoot", "[", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"k", "[", 
         RowBox[{"sol", ",", "r"}], "]"}], " ", "==", 
        FractionBox[
         RowBox[{
          SuperscriptBox["z5", 
           RowBox[{"1", "-", "sol"}]], " ", 
          RowBox[{"AppellF1", "[", 
           RowBox[{
            RowBox[{"1", "-", "sol"}], ",", 
            RowBox[{"1", "-", "sol"}], ",", "sol", ",", 
            RowBox[{"2", "-", "sol"}], ",", "z5", ",", 
            RowBox[{
             SuperscriptBox["r", "2"], " ", "z5"}]}], "]"}], " ", 
          RowBox[{"Sin", "[", 
           RowBox[{"sol", "*", " ", "\[Pi]"}], "]"}]}], 
         RowBox[{" ", 
          RowBox[{"(", 
           RowBox[{"1", "-", "sol"}], ")"}]}]]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"sol", ",", 
         RowBox[{"1", "/", "2"}], ",", "0", ",", "1"}], "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"determine", " ", "alpha"}], ",", " ", 
     RowBox[{"hypergeometric", " ", "parameter"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"\[Alpha]", "=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"a", ">", 
       FractionBox["1", "2"]}], ",", " ", 
      RowBox[{"NestWhile", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "+", 
          FractionBox["\[Pi]", "2"]}], "&"}], ",", 
        RowBox[{
         FractionBox["1", "2"], 
         RowBox[{"ArcTan", "[", 
          RowBox[{
           FractionBox[
            RowBox[{"2", "d1", "*", "d2", "*", 
             RowBox[{"k", "[", 
              RowBox[{"a", ",", "r"}], "]"}], "*", 
             RowBox[{"k", "[", 
              RowBox[{"a", ",", " ", 
               SqrtBox[
                RowBox[{"1", "-", 
                 SuperscriptBox["r", "2"]}]]}], "]"}]}], 
            RowBox[{
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"d1", "*", 
                RowBox[{"k", "[", 
                 RowBox[{"a", ",", " ", 
                  SqrtBox[
                   RowBox[{"1", "-", 
                    SuperscriptBox["r", "2"]}]]}], "]"}]}], ")"}], "2"], "-", 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"d2", "*", 
                RowBox[{"k", "[", 
                 RowBox[{"a", ",", "r"}], "]"}]}], ")"}], "2"]}]], "*", 
           RowBox[{"Cos", "[", 
            RowBox[{"a", "*", "\[Pi]"}], "]"}]}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"#", "<", 
          FractionBox["\[Pi]", "2"]}], "&"}]}], "]"}], ",", " ", 
      RowBox[{"NestWhile", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "+", 
          FractionBox["\[Pi]", "2"]}], "&"}], ",", 
        RowBox[{
         FractionBox["1", "2"], 
         RowBox[{"ArcTan", "[", 
          RowBox[{
           FractionBox[
            RowBox[{"2", "d1", "*", "d2", "*", 
             RowBox[{"k", "[", 
              RowBox[{"a", ",", "r"}], "]"}], "*", 
             RowBox[{"k", "[", 
              RowBox[{"a", ",", " ", 
               SqrtBox[
                RowBox[{"1", "-", 
                 SuperscriptBox["r", "2"]}]]}], "]"}]}], 
            RowBox[{
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"d1", "*", 
                RowBox[{"k", "[", 
                 RowBox[{"a", ",", " ", 
                  SqrtBox[
                   RowBox[{"1", "-", 
                    SuperscriptBox["r", "2"]}]]}], "]"}]}], ")"}], "2"], "-", 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"d2", "*", 
                RowBox[{"k", "[", 
                 RowBox[{"a", ",", "r"}], "]"}]}], ")"}], "2"]}]], "*", 
           RowBox[{"Cos", "[", 
            RowBox[{"a", "*", "\[Pi]"}], "]"}]}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"#", "<", "0"}], "&"}]}], "]"}]}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "find", " ", "ratio", " ", "of", " ", "anisotropic", " ", 
     "conductivities"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"ratio", " ", "=", " ", 
    FractionBox[
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      SqrtBox[
       RowBox[{"1", "+", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"Tan", "[", 
           RowBox[{"a", "*", "\[Pi]"}], "]"}], "2"], "*", 
         SuperscriptBox[
          RowBox[{"Sin", "[", 
           RowBox[{"2", "\[Alpha]"}], "]"}], "2"]}]}]]}], 
     RowBox[{
      RowBox[{"Tan", "[", 
       RowBox[{"a", "*", "\[Pi]"}], "]"}], "*", 
      RowBox[{"Sin", "[", 
       RowBox[{"2", "\[Alpha]"}], "]"}]}]]}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"get", " ", "anisotropic", " ", "conductivites"}], "*)"}], 
