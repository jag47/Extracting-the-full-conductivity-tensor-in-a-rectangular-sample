          RowBox[{"{", 
           RowBox[{"sol", ",", 
            RowBox[{"1", "/", "2"}], ",", "0", ",", "1"}], "}"}]}], 
         "]"}]}]}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "calculate", " ", "the", " ", "geometric", " ", "mean", " ", "of", " ", 
     "the", " ", "anisotropic", " ", "conductivities"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<\!\(\*SqrtBox[\(\*SubscriptBox[\(\[Sigma]\), \(+\)] \*SubscriptBox[\
\(\[Sigma]\), \(-\)]\)]\)= \>\"", ",", 
      RowBox[{"geomean", " ", "=", 
       RowBox[{"-", " ", 
        FractionBox[
         RowBox[{"R1", "*", "\[Pi]", "*", 
          RowBox[{"Log", "[", 
           RowBox[{"1", "-", 
            SuperscriptBox["r", "2"]}], "]"}]}], 
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"R1", "*", "\[Pi]"}], ")"}], "2"], "+", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"R1", "*", 
              RowBox[{"Log", "[", 
               RowBox[{
                FractionBox["1", 
                 SuperscriptBox["r", "2"]], "-", "1"}], "]"}]}], "+", 
             RowBox[{"R3", "*", 
              RowBox[{"Log", "[", 
               RowBox[{"1", "-", 
                SuperscriptBox["r", "2"]}], "]"}]}]}], ")"}], "2"]}]]}]}]}], 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Hall", " ", "conductivity"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\!\(\*SubscriptBox[\(\[Sigma]\), \(H\)]\)= \>\"", ",", 
      RowBox[{"\[Sigma]H", " ", "=", " ", 
       FractionBox[
        RowBox[{
         RowBox[{"Log", "[", 
          RowBox[{"1", "-", 
