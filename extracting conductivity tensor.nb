      " ", "complex", " ", "plane"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\!\(\*SubscriptBox[\(z\), \(5\)]\)= \>\"", ",", 
      RowBox[{"z5", " ", "=", " ", 
       FractionBox[
        RowBox[{
         FractionBox["1", 
          SuperscriptBox["r", "2"]], "-", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"1", "-", 
            SuperscriptBox["r", "2"]}], ")"}], 
          RowBox[{
           RowBox[{"-", "R5"}], "/", "R1"}]]}], 
        RowBox[{"1", "-", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"1", "-", 
            SuperscriptBox["r", "2"]}], ")"}], 
          RowBox[{
           RowBox[{"-", "R5"}], "/", "R1"}]]}]]}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"find", " ", "a"}], ",", " ", 
     RowBox[{"hypergeometric", " ", "parameter"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"k", "[", 
     RowBox[{"a_", ",", "r_"}], "]"}], " ", ":=", " ", 
    RowBox[{
     FractionBox["\[Pi]", "2"], "*", 
     RowBox[{"Hypergeometric2F1", "[", 
      RowBox[{"a", ",", 
       RowBox[{"1", "-", "a"}], ",", "1", ",", 
       SuperscriptBox["r", "2"]}], "]"}]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<a= \>\"", ",", 
      RowBox[{"a", "=", " ", 
       RowBox[{"sol", "/.", 
        RowBox[{"FindRoot", "[", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"k", "[", 
            RowBox[{"sol", ",", "r"}], "]"}], " ", "==", 
           FractionBox[
            RowBox[{
             SuperscriptBox["z5", 
              RowBox[{"1", "-", "sol"}]], " ", 
             RowBox[{"AppellF1", "[", 
              RowBox[{
               RowBox[{"1", "-", "sol"}], ",", 
               RowBox[{"1", "-", "sol"}], ",", "sol", ",", 
               RowBox[{"2", "-", "sol"}], ",", "z5", ",", 
               RowBox[{
                SuperscriptBox["r", "2"], " ", "z5"}]}], "]"}], " ", 
             RowBox[{"Sin", "[", 
              RowBox[{"sol", "*", " ", "\[Pi]"}], "]"}]}], 
            RowBox[{" ", 
             RowBox[{"(", 
              RowBox[{"1", "-", "sol"}], ")"}]}]]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"sol", ",", 
            RowBox[{"1", "/", "2"}], ",", "0", ",", "1"}], "}"}]}], 
         "]"}]}]}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"determine", " ", "alpha"}], ",", " ", 
     RowBox[{"hypergeometric", " ", "parameter"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\[Alpha]= \>\"", ",", 
      RowBox[{"\[Alpha]", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"a", ">", 
          FractionBox["1", "2"]}], ",", " ", 
         RowBox[{"NestWhile", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "+", 
             FractionBox["\[Pi]", "2"]}], "&"}], ",", 
           RowBox[{
            FractionBox["1", "2"], 
            RowBox[{"ArcTan", "[", 
             RowBox[{
              FractionBox[
               RowBox[{"2", "d1", "*", "d2", "*", 
                RowBox[{"k", "[", 
                 RowBox[{"a", ",", "r"}], "]"}], "*", 
                RowBox[{"k", "[", 
                 RowBox[{"a", ",", " ", 
                  SqrtBox[
                   RowBox[{"1", "-", 
                    SuperscriptBox["r", "2"]}]]}], "]"}]}], 
               RowBox[{
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{"d1", "*", 
                   RowBox[{"k", "[", 
                    RowBox[{"a", ",", " ", 
                    SqrtBox[
                    RowBox[{"1", "-", 
                    SuperscriptBox["r", "2"]}]]}], "]"}]}], ")"}], "2"], "-", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{"d2", "*", 
                   RowBox[{"k", "[", 
                    RowBox[{"a", ",", "r"}], "]"}]}], ")"}], "2"]}]], "*", 
              RowBox[{"Cos", "[", 
               RowBox[{"a", "*", "\[Pi]"}], "]"}]}], "]"}]}], ",", 
           RowBox[{
            RowBox[{"#", "<", 
             FractionBox["\[Pi]", "2"]}], "&"}]}], "]"}], ",", " ", 
         RowBox[{"NestWhile", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "+", 
             FractionBox["\[Pi]", "2"]}], "&"}], ",", 
           RowBox[{
            FractionBox["1", "2"], 
            RowBox[{"ArcTan", "[", 
             RowBox[{
              FractionBox[
               RowBox[{"2", "d1", "*", "d2", "*", 
                RowBox[{"k", "[", 
                 RowBox[{"a", ",", "r"}], "]"}], "*", 
                RowBox[{"k", "[", 
                 RowBox[{"a", ",", " ", 
                  SqrtBox[
                   RowBox[{"1", "-", 
                    SuperscriptBox["r", "2"]}]]}], "]"}]}], 
               RowBox[{
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{"d1", "*", 
                   RowBox[{"k", "[", 
                    RowBox[{"a", ",", " ", 
                    SqrtBox[
                    RowBox[{"1", "-", 
                    SuperscriptBox["r", "2"]}]]}], "]"}]}], ")"}], "2"], "-", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{"d2", "*", 
                   RowBox[{"k", "[", 
                    RowBox[{"a", ",", "r"}], "]"}]}], ")"}], "2"]}]], "*", 
              RowBox[{"Cos", "[", 
               RowBox[{"a", "*", "\[Pi]"}], "]"}]}], "]"}]}], ",", 
           RowBox[{
            RowBox[{"#", "<", "0"}], "&"}]}], "]"}]}], "]"}]}]}], "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "find", " ", "ratio", " ", "of", " ", "anisotropic", " ", 
     "conductivities"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<\!\(\*SqrtBox[FractionBox[SubscriptBox[\(\[Sigma]\), \(+\)], \
SubscriptBox[\(\[Sigma]\), \(-\)]]]\)= \>\"", ",", 
      RowBox[{"ratio", " ", "=", " ", 
       FractionBox[
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         SqrtBox[
          RowBox[{"1", "+", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"Tan", "[", 
              RowBox[{"a", "*", "\[Pi]"}], "]"}], "2"], "*", 
            SuperscriptBox[
             RowBox[{"Sin", "[", 
              RowBox[{"2", "\[Alpha]"}], "]"}], "2"]}]}]]}], 
        RowBox[{
         RowBox[{"Tan", "[", 
          RowBox[{"a", "*", "\[Pi]"}], "]"}], "*", 
         RowBox[{"Sin", "[", 
          RowBox[{"2", "\[Alpha]"}], "]"}]}]]}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
